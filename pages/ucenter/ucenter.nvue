		/* Project id 3435416 */
		src: url('//at.alicdn.com/t/font_3435416_ul2cisykxre.woff2?t=1653735004104') format('woff2'),
			url('//at.alicdn.com/t/font_3435416_ul2cisykxre.woff?t=1653735004104') format('woff'),
			url('//at.alicdn.com/t/font_3435416_ul2cisykxre.ttf?t=1653735004104') format('truetype');
	}

	page {
		background-color: $uni-bg-color-grey;
	}

	/* #endif*/

	/* 解决头条小程序字体图标不显示问题，因为头条运行时自动插入了span标签，且有全局字体 */
