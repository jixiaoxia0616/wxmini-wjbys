<template>
	<view class="center">
		<view class="logo" @click="goLogin" :hover-class="!login ? 'logo-hover' : ''">
<!--			<image class="logo-img" :src="login ? userInfo.avatarUrl :avatarUrl"></image> -->
			<view class="logo-title">
				<view style="height: 100%; display: flex; flex-direction: column; justify-content: space-around;">
					<view style="display: flex; flex-direction: row;">
						<text class="uer-name">你好，{{login && userInfo ? userInfo.name : '您未登录'}}</text>
						<text class="uer-name-right"
							v-if="campusAmbassador && campusAmbassador.id">(积分:{{campusAmbassador.integralValue || 0}})</text>
					</view>

					<text class="navigat-arrow"
						v-if="campusAmbassador && campusAmbassador.enterpriseName">{{campusAmbassador.enterpriseName}}</text>
				</view>
				<!-- <view class="go-login-navigat-arrow" v-if="campusAmbassador && campusAmbassador.id">
					<text class="navigat-arrow">积分 : {{campusAmbassador.integralValue || 0}}</text>
				</view> -->
			</view>
		</view>

		<view class="ucenter-card">
			<uni-grid :column="4" :showBorder="false">
				<uni-grid-item>
					<view class="grid-item-box" @click="openMenu(0)">
						<uni-icons type="person-filled" :size="30" :color="uniColorPrimary" />
						<text class="grid-item-box-text">个人信息</text>
					</view>
				</uni-grid-item>
				<uni-grid-item>
					<view class="grid-item-box" @click="openMenu(1)">
						<uni-icons type="compose" :size="30" :color="uniColorPrimary" />
						<text class="grid-item-box-text">教育经历</text>
					</view>
				</uni-grid-item>
				<uni-grid-item>
					<view class="grid-item-box" @click="openMenu(4)">
						<uni-icons type="cloud-download-filled" :size="30" :color="uniColorPrimary" />
						<text class="grid-item-box-text">我的订阅</text>
					</view>
				</uni-grid-item>
				<uni-grid-item>
					<view class="grid-item-box" @click="openMenu(6)">
						<uni-icons type="paperplane-filled" :size="30" :color="uniColorPrimary" />
						<text class="grid-item-box-text">简历投递</text>
					</view>
				</uni-grid-item>

			</uni-grid>
		</view>

		<view class="center-list">
			<view class="center-list-item" v-if="userInfo.campusAmbassadorStatus != '2'" @click="openMenu(2)">
				<text class="list-icon">&#xe734;</text>
				<text class="list-text">申请校园大使</text>
				<text class="list-item-navigat-arrow">&#xe63c;</text>
			</view>
			<view class="center-list-item" v-if="userInfo.campusAmbassadorStatus == '2'" @click="openMenu(3)">
				<text class="list-icon">&#xe600;</text>
				<text class="list-text">校园大使</text>
				<text class="list-item-navigat-arrow">&#xe63c;</text>
			</view>
			<view class="center-list-item" v-if="userInfo.campusAmbassadorStatus == '2'" @click="openMenu(7)">
				<text class="list-icon">&#xe701;</text>
				<text class="list-text">我推荐过的职位</text>
				<text class="list-item-navigat-arrow">&#xe63c;</text>
			</view>
			<view class="center-list-item" v-if="userInfo.campusAmbassadorStatus == '2'" @click="openMenu(8)">
				<text class="list-icon">&#xe60c;</text>
				<text class="list-text">校园大使排名</text>
				<text class="list-item-navigat-arrow">&#xe63c;</text>
			</view>
			<view class="center-list-item" @click="openMenu(9)">
				<text class="list-icon">&#xe701;</text>
				<text class="list-text">消息</text>
				<text class="list-item-navigat-arrow">&#xe63c;</text>
			</view>
		</view>

		<view class="time-out-btn">
			<button style="font-size: 30rpx;" @click="studentOutLogin()">退出登录</button>
		</view>
	</view>
</template>

<script>
	import {
		studentOut
	} from '@/apis/api.js'
	export default {
		data() {
			return {
				login: false,
				avatarUrl: '/static/logo.png',
				campusAmbassador: null,
				userInfo: {},
				uniColorPrimary: "#34acc3"
			}
		},
		onLoad() {
			wx.showShareMenu({
				withShareTicket: true,
				menus: ["shareAppMessage", "shareTimeline"]
			})
		},
		onShow: function() {
			// this.getWxUser()
			if (getApp().globalData && getApp().globalData.wxUser && getApp().globalData.wxUser.openid) {
				this.getWxUser()
			} else {
				getApp().watch(this.getWxUser, 'wxUser')
			}

		},
		methods: {
			getWxUser() {
				let wxUser = getApp().globalData.wxUser
				if (wxUser && wxUser.openid) {
					this.login = true
					this.userInfo.avatarUrl = wxUser.avatarUrl
					this.userInfo.name = wxUser.studentName
					this.userInfo.campusAmbassadorStatus = wxUser.campusAmbassadorStatus
					this.campusAmbassador = wxUser.campusAmbassador
				}
			},
			goLogin() {
				getApp().isLogin()
			},
			async studentOutLogin() {
				if (!getApp().isLogin()) {
					return
				}
				let wxUser = getApp().globalData.wxUser
				let res = await studentOut({
					openid: wxUser.openid
				})
				if (res && res.code == 200) {
					getApp().globalData.isLogin = false
					getApp().globalData.wxUser = null
					uni.reLaunch({
						url: '/pages/login/loginMain'
					})
				}
				console.log('res', res)

			},
			openMenu(type) {
				if (!getApp().isLogin()) {
					return
				}
				if (type == 0 || type == 1) {
					uni.navigateTo({
						url: '/pages/ucenter/basePerson/basePerson?type=' + type
					})
				} else if (type == 2 || type == 3) {
					uni.navigateTo({
						url: '/pages/ucenter/messenger/messenger'
					})
				} else if (type == 4) {
					uni.navigateTo({
						url: '/pages/ucenter/subscribe/subscribe'
					})
				} else if (type == 5) {
					uni.navigateTo({
						url: '/pages/ucenter/message/message'
					})
				} else if (type == 6) {
					uni.navigateTo({
						url: '/pages/myDeliverList/myDeliverList'
					})
				} else if (type == 7) {
					uni.navigateTo({
						url: '/pages/ucenter/recommend/recommend'
					})
				} else if (type == 8) {
					uni.navigateTo({
						url: '/pages/ucenter/ambassadorRanking/ambassadorRanking'
					})
				}else if(type == 9){
					uni.navigateTo({
						url:'/pages/ucenter/message/message'
					})
				}
			}
		}
	}
</script>

<style lang="scss" scoped>
